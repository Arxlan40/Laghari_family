rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserData() {
      return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'arxlanumer50@gmail.com' ||
         (userDocExists() && getUserData().role == 'super_admin'));
    }
    function isAdmin() {
      return isAuthenticated() && 
        (isSuperAdmin() || 
         (userDocExists() && getUserData().role == 'admin'));
    }
    function isHamdardAdmin() {
      return isAuthenticated() && 
        (isSuperAdmin() || 
         (userDocExists() && getUserData().is_hamdard_admin == true));
    }

    // 1. Family Members Collection
    match /family_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users Collection
    match /users/{userId} {
      // Normal users can read and update their own document, but cannot tamper with role or is_hamdard_admin.
      // Super Admins can manage roles/status/hamdard admins and delete users if needed.
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isOwner(userId) || isAdmin() || isHamdardAdmin();
      allow update: if isSuperAdmin() || 
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_hamdard_admin'])) ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'is_hamdard_admin']));
      allow delete: if isAdmin();

      // Explicit protection for nested device/location info if stored in subcollections
      match /deviceInfo/{docId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if isOwner(userId) || isSuperAdmin();
      }
      match /location/{docId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // 3. Edit Requests Collection
    match /edit_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // 4. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // 5. Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 6. Audit Logs Collection (Super Admin only)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // 7. Deleted Members Collection
    match /deleted_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. Hamdard Laghari — Financial Transparency & Audit Rules
    // -------------------------------------------------------------
    // Hamdard People:
    // Read: All authenticated users (transparent community registry)
    // Write: Hamdard Admin and Super Admin
    match /hamdard_people/{personId} {
      allow read: if isAuthenticated();
      allow write: if isHamdardAdmin();
    }

    // Hamdard Donations:
    // Read: All authenticated users (transparent financial collection)
    // Write: Hamdard Admin and Super Admin
    match /hamdard_donations/{donationId} {
      allow read: if isAuthenticated();
      allow write: if isHamdardAdmin();
    }

    // Hamdard Spending:
    // Read: All authenticated users (transparent community expenditures)
    // Write: Hamdard Admin and Super Admin
    match /hamdard_spending/{spendingId} {
      allow read: if isAuthenticated();
      allow write: if isHamdardAdmin();
    }

    // Hamdard Financial Settings (Opening balance, accounting config):
    // Read: All authenticated users
    // Write: Super Admin ONLY
    match /hamdard_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Hamdard Financial Audit Trail:
    // Read: Super Admin ONLY
    // Create: Hamdard Admin & Super Admin (automatic audit recording)
    // Update/Delete: Super Admin ONLY (immutable to normal admins)
    match /hamdard_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isHamdardAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // Fallback rule for backward compatibility
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
